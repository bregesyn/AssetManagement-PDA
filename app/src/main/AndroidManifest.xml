            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.inbound.InboundActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.rfid.RfidUnbindActivity"
            android:exported="false" />
        <activity
            android:name=".feature.inventory.InventoryExecuteActivity"
