<resources>
    <style name="Base.Theme.Assetmanagementpda" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/pda_primary</item>
        <item name="colorPrimaryDark">@color/pda_primary_dark</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/pda_primary</item>
        <item name="android:statusBarColor">@color/pda_primary_dark</item>
        <item name="android:navigationBarColor">@color/pda_card_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/pda_background</item>
    </style>

    <style name="Theme.Assetmanagementpda" parent="Base.Theme.Assetmanagementpda" />

    <style name="PdaPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/pda_touch_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/pda_button_text_size</item>
        <item name="cornerRadius">@dimen/pda_control_radius</item>
    </style>

    <style name="PdaOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/pda_touch_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/pda_button_text_size</item>
        <item name="cornerRadius">@dimen/pda_control_radius</item>
    </style>

    <style name="PdaTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/pda_compact_touch_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/pda_caption_size</item>
        <item name="cornerRadius">@dimen/pda_control_radius</item>
    </style>

    <style name="PdaTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/pda_control_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/pda_control_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/pda_control_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/pda_control_radius</item>
    </style>

    <!--
        详情页沿用历史 PDA 的“标签 + 值”阅读顺序；值区域保持可换行，
        这样 EPC 或资产名称较长时不会被小屏固定行高截断。
    -->
    <style name="PdaFactRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/pda_fact_row_spacing</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/pda_fact_row_min_height</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="PdaFactLabel">
        <item name="android:layout_width">@dimen/pda_fact_label_width</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingEnd">@dimen/pda_small_spacing</item>
        <item name="android:textColor">@color/pda_text_secondary</item>
        <item name="android:textSize">@dimen/pda_caption_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PdaFactValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/pda_fact_row_min_height</item>
        <item name="android:paddingStart">@dimen/pda_small_spacing</item>
        <item name="android:textColor">@color/pda_text_primary</item>
        <item name="android:textSize">@dimen/pda_body_size</item>
    </style>

</resources>
