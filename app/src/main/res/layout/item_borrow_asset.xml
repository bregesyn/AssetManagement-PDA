<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/pda_small_spacing"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/pda_card_background"
    app:cardCornerRadius="@dimen/pda_control_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/pda_card_stroke"
    app:strokeWidth="@dimen/pda_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/pda_status_rail_width"
            android:layout_height="match_parent"
            android:background="@color/pda_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/pda_item_spacing"
            android:paddingTop="@dimen/pda_item_spacing"
            android:paddingEnd="@dimen/pda_small_spacing"
            android:paddingBottom="@dimen/pda_small_spacing">

            <TextView
                android:id="@+id/borrowAssetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/pda_text_primary"
                android:textSize="@dimen/pda_body_size"
                android:textStyle="bold"
                tools:text="ZC-0001 · 示范资产" />

            <TextView
                android:id="@+id/borrowAssetMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/pda_text_secondary"
                android:textSize="@dimen/pda_caption_size"
                tools:text="办公设备 · 在库" />

            <TextView
                android:id="@+id/borrowAssetStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/pda_primary"
                android:textSize="@dimen/pda_utility_size"
                android:textStyle="bold"
                tools:text="可提交" />

            <TextView
                android:id="@+id/borrowAssetSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/pda_text_secondary"
                android:textSize="@dimen/pda_utility_size"
                tools:text="RFID" />

            <TextView
                android:id="@+id/borrowAssetContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/pda_text_secondary"
                android:textSize="@dimen/pda_utility_size"
                android:visibility="gone"
                tools:text="借用单 LY202608050001 · 原仓位：一号仓 / A-01"
                tools:visibility="visible" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/borrowAssetRemove"
            style="@style/PdaTextButton"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/borrow_remove" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
