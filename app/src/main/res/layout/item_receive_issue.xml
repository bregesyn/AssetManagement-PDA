<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/pda_touch_height"
    android:orientation="horizontal">

    <View
        android:layout_width="@dimen/pda_status_rail_width"
        android:layout_height="match_parent"
        android:background="@color/pda_error" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/pda_item_spacing">

        <TextView
            android:id="@+id/receiveIssueIdentifier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/pda_text_primary"
            android:textSize="@dimen/pda_caption_size"
            android:textStyle="bold"
            tools:text="E2000017221101441890ABCD" />

        <TextView
            android:id="@+id/receiveIssueAsset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/pda_text_secondary"
            android:textSize="@dimen/pda_utility_size"
            tools:text="ZC202600001 · 手持终端" />

        <TextView
            android:id="@+id/receiveIssueReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/pda_error"
            android:textSize="@dimen/pda_utility_size"
            tools:text="资产当前不在库，不能领用" />
    </LinearLayout>
</LinearLayout>
