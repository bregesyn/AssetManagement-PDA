<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/pda_item_spacing"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/pda_card_background"
    app:cardCornerRadius="@dimen/pda_card_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/pda_card_stroke"
    app:strokeWidth="@dimen/pda_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/pda_card_padding">

        <TextView
            android:id="@+id/repairerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pda_text_primary"
            android:textSize="@dimen/pda_body_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/repairerLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pda_small_spacing"
            android:fontFamily="monospace"
            android:textColor="@color/pda_text_secondary"
            android:textSize="@dimen/pda_caption_size" />

        <TextView
            android:id="@+id/repairerDepartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pda_text_secondary"
            android:textSize="@dimen/pda_caption_size" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
