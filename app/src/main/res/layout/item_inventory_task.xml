<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/pda_item_spacing"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/pda_card_background"
    app:cardCornerRadius="@dimen/pda_card_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/pda_card_stroke"
    app:strokeWidth="@dimen/pda_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/inventoryTaskRail"
            android:layout_width="@dimen/pda_status_rail_width"
            android:layout_height="match_parent"
            android:background="@color/pda_pending" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/pda_card_padding">

            <TextView
                android:id="@+id/inventoryTaskNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/pda_text_primary"
                android:textSize="@dimen/pda_body_size"
                android:textStyle="bold"
                tools:text="PD2026...0001" />

            <TextView
                android:id="@+id/inventoryTaskScope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pda_small_spacing"
                android:textColor="@color/pda_text_secondary"
                android:textSize="@dimen/pda_caption_size"
                tools:text="一号仓 · 全部在库资产" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pda_item_spacing"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/inventoryTaskProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/pda_primary_dark"
                    android:textSize="@dimen/pda_caption_size"
                    tools:text="已盘 18 / 42" />

                <TextView
                    android:id="@+id/inventoryTaskStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/pda_pending_soft"
                    android:paddingStart="@dimen/pda_item_spacing"
                    android:paddingTop="@dimen/pda_small_spacing"
                    android:paddingEnd="@dimen/pda_item_spacing"
                    android:paddingBottom="@dimen/pda_small_spacing"
                    android:textColor="@color/pda_pending"
                    android:textSize="@dimen/pda_utility_size"
                    android:textStyle="bold"
                    tools:text="盘点中" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/inventoryTaskAction"
                style="@style/PdaPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pda_item_spacing"
                android:text="@string/inventory_task_continue_action" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
